        <mxCell id="FlxN8AWg-q_O8-KOhY1z-2" value="timer:&lt;div&gt;TIM2 APB1=45MHz&lt;br&gt;&lt;div&gt;&amp;nbsp;contador ascendente con autorecarga sin interrupcion inicia con base de tiempo en 8k&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
